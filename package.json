  },
  "keywords": [
    "cli",
    "claude-code",
    "skill",
    "ideas",
    "sqlite",
    "bun"
  ],
  "license": "MIT",
  "engines": {
    "bun": ">=1.1.0"
  },
  "devDependencies": {
    "@types/bun": "^1.1.0"
  }
