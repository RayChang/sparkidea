{
  "name": "sparkidea",
  "version": "0.1.0",
  "description": "⚡ SparkIdea — a CLI + Claude Code skill that captures fleeting development ideas into SQLite without breaking your flow.",
  "module": "skills/sparkidea/scripts/index.ts",
